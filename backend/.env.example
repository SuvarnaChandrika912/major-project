APP_ENV=development
LOG_LEVEL=INFO

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bis_saathi
MYSQL_USER=
MYSQL_PASSWORD=

# ---- Pinecone (free Starter tier works) ----
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bis-saathi
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=bis-documents

# ---- LLM (Groq — default) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# ---- LLM (Ollama, local alternative) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_SECONDS=180

# ---- Embeddings / retrieval ----
# Pinecone Inference model; must match the dense Pinecone index dimension
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
# Optional cross-encoder reranker, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 (leave empty to disable)
RERANKER_MODEL=
RETRIEVAL_TOP_K=8

# ---- OCR (Tesseract) ----
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated emails that receive administrator rights (document ingestion, labs, schemes)
ADMIN_EMAILS=

# ---- Uploads ----
MAX_UPLOAD_MB=50

# ---- Optional Redis cache ----
REDIS_URL=

FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
