# =============================================================================
# BIS SAATHI — project environment (copy to .env and fill the required values)
# =============================================================================
# Backend reads this file from the project root (see backend/app/config.py).
# Frontend loads NEXT_PUBLIC_* from here via frontend/next.config.ts.
#
# Required to run: MYSQL_USER, MYSQL_PASSWORD, JWT_SECRET_KEY, ADMIN_EMAILS
# Strongly recommended: PINECONE_API_KEY (hybrid retrieval), GROQ_API_KEY (AI answers)
# =============================================================================

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend — general ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- MySQL (local MySQL80 service) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bis_saathi
MYSQL_USER=
MYSQL_PASSWORD=

# ---- Pinecone (dense vector search; leave API key empty to use BM25-only mode) ----
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bis-saathi
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=bis-documents

# ---- LLM (Groq cloud API) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Local alternative: LLM_PROVIDER=ollama, OLLAMA_BASE_URL, OLLAMA_MODEL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_SECONDS=180

# ---- Pinecone Inference embeddings (dimension must match Pinecone index) ----
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=
RETRIEVAL_TOP_K=8

# ---- OCR (only for scanned PDFs) ----
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng

# ---- Auth ----
# Generate: py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Your login email — required for Knowledge Base / document upload (comma-separated list)
ADMIN_EMAILS=

# ---- Uploads & CORS ----
MAX_UPLOAD_MB=50
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# ---- Optional ----
REDIS_URL=

# ---- Windows Smart App Control (set to 1 if SQLAlchemy DLL is blocked) ----
DISABLE_SQLALCHEMY_CEXT_RUNTIME=1